# Database — DB_HOST is set to "db" automatically by docker-compose, do not set it here
DB_NAME=mail_agent
DB_USER=mail_user
DB_PASSWORD=changeme
DB_PORT=5432

# Ollama
OLLAMA_API_URL=http://your-ollama-host:11435/api/chat
OLLAMA_MODEL=qwen2.5:7b
# Optional: only needed if Ollama requires HTTP basic auth
# OLLAMA_BASIC_USER=youruser
# OLLAMA_BASIC_PASS=yourpassword

# Optional: how often the agent runs in seconds (default: 3600)
# RUN_INTERVAL_SECONDS=3600
